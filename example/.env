# AI Provider Configuration
# Set this to "google" or "openai" to choose your provider.
AI_PROVIDER=google

# Google Gemini API Key (Server-side)
# This is used by Genkit on the server. Do not add NEXT_PUBLIC_ prefix.
GOOGLE_API_KEY=

# OpenAI API Key (Server-side)
# This is used by Genkit on the server if AI_PROVIDER is "openai".
OPENAI_API_KEY=

# Firebase Configuration (Client-side)
# These keys are required for the app's frontend to connect to Firebase services.
# The NEXT_PUBLIC_ prefix makes them available in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Payment Gateway Configuration
# These are used on the client-side for payment processing.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Live Chat Widget Configuration
# These are used on the client-side to load the Tawk.to widget.
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=
NEXT_PUBLIC_TAWKTO_WIDGET_ID=
